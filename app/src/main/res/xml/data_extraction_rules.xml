<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup / device-transfer rules. Only plain settings are included; the shop database is not
     (it is encrypted with a key that cannot move to another phone, so a copy would be unreadable there); the encrypted credential files (Daraja keys, sync secrets) stay on this device
     because their Keystore keys cannot move to another phone anyway.
     Cloud backup is skipped on phones that cannot encrypt it (no screen lock), so shop data never goes to the
     cloud in the clear. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="minimart_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="minimart_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
